# URL-base da API BankSystemDevTrail sob teste (sem barra no final)
API_BASE_URL=http://localhost:5082

# Token opcional: use somente se sua API exigir autenticação Bearer
API_TOKEN=

# Connection string exclusiva do banco de testes, usada somente para remover dados AUTO após transações.
# Nunca aponte para produção ou ambientes compartilhados.
TEST_DB_CONNECTION_STRING=

# URL opcional do Pushgateway local. Quando definida, os resultados dos testes são enviados ao Grafana via Prometheus.
PUSHGATEWAY_URL=http://localhost:9091

# Integração opcional com Grafana Cloud. Copie os valores em Stack > Prometheus > Details.
# Use uma Access Policy Token com escopo metrics:write e nunca versione essas credenciais.
GRAFANA_CLOUD_METRICS_URL=
GRAFANA_CLOUD_METRICS_USERNAME=
GRAFANA_CLOUD_METRICS_TOKEN=
