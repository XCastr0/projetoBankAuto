{
  "name": "api-test-automation",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test tests/api",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "observability:up": "docker compose -f observability/docker-compose.yml up -d",
    "observability:down": "docker compose -f observability/docker-compose.yml down",
    "observability:cloud:up": "docker compose -f observability/docker-compose.yml -f observability/docker-compose.cloud.yml up -d alloy",
    "observability:cloud:down": "docker compose -f observability/docker-compose.yml -f observability/docker-compose.cloud.yml stop alloy",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/mssql": "^12.3.0",
    "@types/node": "^24.0.0",
    "dotenv": "^17.0.0",
    "mssql": "^12.7.2",
    "typescript": "^5.8.0"
  }
}
